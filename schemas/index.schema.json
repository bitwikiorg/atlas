{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/index.schema.json",
  "title": "BITwiki Atlas Public Index",
  "type": "object",
  "required": ["version", "repositories"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": ["string", "null"] },
    "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["repo_id", "owner", "repo", "repo_url", "source_sha", "last_indexed_at", "template_id", "github_docs_url", "manifest_uri"],
      "properties": {
        "repo_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "repo_url": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "source_sha": { "type": "string", "minLength": 7 },
        "last_indexed_at": { "type": "string" },
        "template_id": { "type": "string" },
        "language": { "type": "string" },
        "foundry_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "score_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_grade": { "type": "string" },
        "doc_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "github_stars": { "type": "integer", "minimum": 0 },
        "github_forks": { "type": "integer", "minimum": 0 },
        "version_count": { "type": "integer", "minimum": 1 },
        "words_generated": { "type": "integer", "minimum": 0 },
        "source_files_mapped": { "type": "integer", "minimum": 0 },
        "agent_runs": { "type": "integer", "minimum": 0 },
        "graph_nodes": { "type": "integer", "minimum": 0 },
        "graph_edges": { "type": "integer", "minimum": 0 },
        "graph_entities": { "type": "integer", "minimum": 0 },
        "model_tokens": { "type": "integer", "minimum": 0 },
        "generation_seconds": { "type": "number", "minimum": 0 },
        "impressions": { "type": "integer", "minimum": 0, "description": "Optional analytics snapshot. Live Foundry impressions are measured from canonical /atlas/<owner>/<repo> pageviews." },
        "github_docs_url": { "type": "string", "format": "uri" },
        "download_url": { "type": "string" },
        "atlas_url": { "type": "string" },
        "manifest_uri": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
