{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/visual.schema.json",
  "title": "BITwiki Atlas Visual Data View",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "id", "title", "kind", "purpose", "origin", "layout", "renderer", "nodes", "edges"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "purpose": {"type": "string"},
    "origin": {"type": "string", "enum": ["deterministic", "curated", "semantic"]},
    "layout": {
      "type": "object",
      "required": ["family", "direction"],
      "properties": {
        "family": {"type": "string", "enum": ["layered", "tree", "radial", "force", "grid"]},
        "direction": {"type": "string", "enum": ["LR", "RL", "TB", "BT"]},
        "engine": {"type": "string"}
      }
    },
    "renderer": {
      "type": "object",
      "required": ["source_of_truth"],
      "properties": {
        "interactive": {"type": "string"},
        "portable_fallback": {"type": "string"},
        "source_of_truth": {"const": "visual-data"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "group": {"type": "string"},
          "type": {"type": "string", "minLength": 1},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "source_paths": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "type": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
