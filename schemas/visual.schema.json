{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/visual.schema.json",
  "title": "BITwiki Atlas Semantic Visual View",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "id", "title", "kind", "question", "purpose", "origin", "diagram_type", "doc_paths", "layout", "renderer", "presentation", "nodes", "edges", "evidence_refs", "stats"],
  "properties": {
    "version": {"type": "integer", "minimum": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "enum": ["deterministic", "curated", "semantic"]},
    "diagram_type": {
      "type": "string",
      "enum": ["network", "flowchart", "swimlanes", "sequence", "class", "state", "er", "user-journey", "gantt", "pie", "quadrant", "requirement", "gitgraph", "c4", "mindmap", "timeline", "zenuml", "sankey", "xy", "block", "packet", "kanban", "architecture", "radar", "event-modeling", "treemap", "venn", "ishikawa", "wardley", "cynefin", "treeview"]
    },
    "doc_paths": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "pattern": "^(README\\.md|docs/[A-Za-z0-9_.\\/-]+\\.md)$"}
    },
    "layout": {
      "type": "object",
      "required": ["family", "direction"],
      "properties": {
        "family": {"type": "string", "enum": ["layered", "tree", "radial", "force", "grid"]},
        "direction": {"type": "string", "enum": ["LR", "RL", "TB", "BT"]},
        "engine": {"type": "string"}
      }
    },
    "renderer": {
      "type": "object",
      "required": ["interactive", "portable_fallback", "source_of_truth"],
      "properties": {
        "interactive": {"type": "string", "enum": ["mermaid", "cytoscape"]},
        "portable_fallback": {"type": "string"},
        "source_of_truth": {"const": "visual-data"}
      }
    },
    "presentation": {
      "type": "object",
      "required": ["renderer", "diagram_type", "source_of_truth"],
      "properties": {
        "renderer": {"type": "string", "enum": ["mermaid", "cytoscape"]},
        "diagram_type": {"type": "string"},
        "mermaid_source": {"type": "string"},
        "source_of_truth": {"const": "visual-data"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "evidence_refs", "source_paths"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "full_label": {"type": "string"},
          "group": {"type": "string"},
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "source_paths": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "label": {"type": "string", "maxLength": 100},
          "type": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "value": {"type": "number"},
          "order": {"type": "number"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "data_points": {"type": "array", "items": {"type": "object"}},
    "legend": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "stats": {"type": "object"}
  }
}
