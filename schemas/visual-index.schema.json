{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/visual-index.schema.json",
  "title": "BITwiki Atlas Visual Index",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "repo_id", "source_sha", "canonical_graph", "renderer_policy", "views"],
  "properties": {
    "version": {"type": "integer", "minimum": 2},
    "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_sha": {"type": "string", "minLength": 7},
    "canonical_graph": {"const": "graph.json"},
    "renderer_policy": {
      "type": "object",
      "required": ["source_of_truth"],
      "properties": {
        "interactive": {"type": "string"},
        "semantic_diagrams": {"type": "string"},
        "layered_layout": {"type": "string"},
        "portable_fallback": {"type": "string"},
        "mermaid_security": {"type": "string"},
        "source_of_truth": {"const": "visual-data"}
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "question", "purpose", "origin", "diagram_type", "doc_paths", "layout", "presentation", "stats", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "question": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "origin": {"type": "string", "enum": ["deterministic", "semantic"]},
          "diagram_type": {"type": "string"},
          "doc_paths": {"type": "array", "items": {"type": "string"}},
          "layout": {"type": "object"},
          "presentation": {"type": "object"},
          "stats": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "path": {"type": "string", "pattern": "^visuals/views/[a-z0-9][a-z0-9-]*\\.json$"}
        }
      }
    }
  }
}
