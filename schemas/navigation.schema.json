{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/navigation.schema.json",
  "title": "BITwiki Atlas Navigation",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "repo_id", "source_sha", "primary_page", "groups", "quality"],
  "properties": {
    "version": {"type": "integer", "minimum": 2},
    "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_sha": {"type": "string", "minLength": 7},
    "primary_page": {"type": "string", "minLength": 1},
    "quality": {
      "type": "object",
      "required": ["group_count", "page_count", "coverage_ratio", "fallback_count", "fallback_ratio", "generic_only", "score"],
      "properties": {
        "group_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "page_count": {"type": "integer", "minimum": 1},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "fallback_count": {"type": "integer", "minimum": 0},
        "fallback_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "generic_only": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "pages"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "title"],
              "properties": {
                "path": {"type": "string"},
                "title": {"type": "string", "minLength": 1},
                "description": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
