{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/navigation.schema.json",
  "title": "BITwiki Atlas Navigation",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "repo_id", "source_sha", "primary_page", "groups"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_sha": {"type": "string", "minLength": 7},
    "primary_page": {"type": "string"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "pages"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "title"],
              "properties": {
                "path": {"type": "string"},
                "title": {"type": "string", "minLength": 1},
                "description": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
