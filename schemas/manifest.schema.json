{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitwikiorg/atlas/schemas/manifest.schema.json",
  "title": "BITwiki Atlas Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "repo_id", "repo_url", "source_sha", "template", "generated_at", "files"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "repo_url": {"type": "string", "format": "uri"},
    "source_sha": {"type": "string", "minLength": 7},
    "template": {"type": "string", "enum": ["base", "library", "service", "application", "monorepo", "protocol", "research"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "foundry_score": {"type": "number", "minimum": 0, "maximum": 100},
    "score_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "score_version": {"type": "string"},
    "scoring_version": {"type": "string", "description": "Legacy alias for score_version."},
    "evidence_grade": {"type": "string"},
    "source_visibility_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1, "description": "Legacy alias for source_visibility_ratio."},
    "doc_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "words_generated": {"type": "integer", "minimum": 0},
    "source_files_mapped": {"type": "integer", "minimum": 0},
    "agent_runs": {"type": "integer", "minimum": 0},
    "graph_nodes": {"type": "integer", "minimum": 0},
    "graph_edges": {"type": "integer", "minimum": 0},
    "graph_entities": {"type": "integer", "minimum": 0},
    "visual_count": {"type": "integer", "minimum": 0},
    "visual_nodes": {"type": "integer", "minimum": 0},
    "visual_edges": {"type": "integer", "minimum": 0},
    "semantic_visuals": {"type": "integer", "minimum": 0},
    "visual_kinds": {"type": "array", "items": {"type": "string"}},
    "navigation_groups": {"type": "integer", "minimum": 0},
    "navigation_quality": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {
          "type": "object",
          "required": ["group_count", "page_count", "coverage_ratio", "fallback_count", "fallback_ratio", "generic_only", "score"],
          "properties": {
            "strategy": {"type": "string"},
            "group_count": {"type": "integer", "minimum": 1},
            "page_count": {"type": "integer", "minimum": 1},
            "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "fallback_count": {"type": "integer", "minimum": 0},
            "fallback_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "generic_only": {"type": "boolean"},
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "duplicate_paths": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "model_tokens": {"type": "integer", "minimum": 0},
    "generation_seconds": {"type": "number", "minimum": 0},
    "files": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
