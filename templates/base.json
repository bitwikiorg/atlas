{
  "id": "base",
  "version": 3,
  "required_outputs": [
    "README.md",
    "docs/overview.md",
    "docs/architecture.md",
    "docs/quickstart.md",
    "docs/reference.md",
    "docs/testing.md",
    "docs/faq.md",
    "docs/glossary.md",
    "docs/scorecard.md",
    "docs/provenance.md",
    "navigation.json",
    "graph.json",
    "visuals/index.json",
    "scorecard.json",
    "provenance.jsonl",
    "llms.txt",
    "llms-full.txt",
    "manifest.json",
    "bundle.json"
  ],
  "section_order": [
    "overview",
    "quickstart",
    "architecture",
    "core-concepts",
    "components",
    "interfaces",
    "data-state",
    "configuration",
    "testing-quality",
    "operations",
    "security",
    "extension",
    "troubleshooting",
    "faq",
    "glossary",
    "scorecard",
    "history-change",
    "provenance",
    "machine-interfaces"
  ],
  "optional_sections": ["operations", "security", "data-state", "extension", "history-change"],
  "visual_defaults": ["repository-topology", "dependency-surface", "evidence-map"],
  "visual_policy": {
    "minimum_views": 4,
    "minimum_semantic_views": 1,
    "maximum_views": 10,
    "maximum_semantic_nodes": 48,
    "maximum_network_nodes": 140,
    "canonical_graph": "graph.json",
    "source_of_truth": "visual-data",
    "interactive_renderer": "cytoscape",
    "semantic_renderer": "mermaid-when-compiled",
    "layered_layout": "elk-layered",
    "portable_fallback": "semantic-json",
    "mermaid_security": "strict",
    "diagram_types": ["flowchart", "swimlane", "sequence", "class", "state", "er", "user_journey", "gantt", "pie", "quadrant", "requirement", "gitgraph", "c4", "mindmap", "timeline", "zenuml", "sankey", "xy", "block", "packet", "kanban", "architecture", "radar", "event_modeling", "treemap", "venn", "ishikawa", "wardley", "cynefin", "treeview", "network"]
  },
  "navigation_policy": {
    "docs_are_primary": true,
    "preferred_groups_min": 3,
    "preferred_groups_max": 7,
    "generic_single_group_max_pages": 3,
    "minimum_quality": 0.75
  },
  "rules": {
    "source_links_required": true,
    "unsupported_sections_omitted": true,
    "external_research_isolated": true,
    "portable_outputs_first": true,
    "generated_version_immutable": true,
    "documentation_is_primary_human_surface": true,
    "visuals_are_first_class_explanations": true,
    "visuals_are_data": true,
    "source_graph_semantic_graph_visual_views_are_distinct": true,
    "model_generated_renderer_syntax": false,
    "quantity_padding_visuals": false
  }
}
