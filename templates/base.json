{
  "id": "base",
  "version": 2,
  "required_outputs": [
    "README.md",
    "docs/overview.md",
    "docs/architecture.md",
    "docs/quickstart.md",
    "docs/reference.md",
    "docs/testing.md",
    "docs/faq.md",
    "docs/glossary.md",
    "docs/scorecard.md",
    "docs/provenance.md",
    "navigation.json",
    "graph.json",
    "visuals/index.json",
    "scorecard.json",
    "provenance.jsonl",
    "llms.txt",
    "llms-full.txt",
    "manifest.json",
    "bundle.json"
  ],
  "section_order": [
    "overview",
    "quickstart",
    "architecture",
    "visual-system-map",
    "core-concepts",
    "components",
    "interfaces",
    "data-state",
    "configuration",
    "testing-quality",
    "operations",
    "security",
    "extension",
    "troubleshooting",
    "faq",
    "glossary",
    "scorecard",
    "history-change",
    "provenance",
    "machine-interfaces"
  ],
  "optional_sections": [
    "operations",
    "security",
    "data-state",
    "extension",
    "history-change"
  ],
  "visual_defaults": [
    "repository-topology",
    "dependency-surface",
    "evidence-map",
    "architecture"
  ],
  "visual_policy": {
    "minimum_views": 4,
    "maximum_views": 10,
    "canonical_graph": "graph.json",
    "source_of_truth": "visual-data",
    "interactive_renderer": "cytoscape",
    "layered_layout": "elk-layered",
    "portable_fallback": "mermaid",
    "mermaid_security": "strict"
  },
  "rules": {
    "source_links_required": true,
    "unsupported_sections_omitted": true,
    "external_research_isolated": true,
    "portable_outputs_first": true,
    "generated_version_immutable": true,
    "visuals_are_data": true,
    "model_generated_renderer_syntax": false
  }
}
